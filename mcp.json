{
  "mcpServers": {
    "telegram-bot": {
      "command": "npx",
      "args": [
        "-y",
        "grokbot-telegram",
        "bot"
      ],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
        "TELEGRAM_DISCLAIMER": "${TELEGRAM_DISCLAIMER}"
      }
    },
    "telegram-user": {
      "command": "npx",
      "args": [
        "-y",
        "grokbot-telegram",
        "user"
      ],
      "env": {
        "TELEGRAM_API_ID": "${TELEGRAM_API_ID}",
        "TELEGRAM_API_HASH": "${TELEGRAM_API_HASH}",
        "TELEGRAM_SESSION": "${TELEGRAM_SESSION}",
        "TELEGRAM_DISCLAIMER": "${TELEGRAM_DISCLAIMER}"
      }
    }
  }
}
