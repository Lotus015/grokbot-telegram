{
  "name": "cursor-telegram-user-mcp",
  "version": "0.3.0",
  "description": "Stdio MCP server for a personal Telegram account via MTProto (teleproto). Install with npx; credentials come from TELEGRAM_API_ID, TELEGRAM_API_HASH, and TELEGRAM_SESSION.",
  "type": "module",
  "license": "MIT",
  "author": "Lotus / Lotus015",
  "homepage": "https://github.com/Lotus015/cursor-telegram-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lotus015/cursor-telegram-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lotus015/cursor-telegram-plugin.git",
    "directory": "packages/mcp-user-server"
  },
  "keywords": [
    "telegram",
    "mtproto",
    "mcp",
    "cursor",
    "stdio",
    "user-account",
    "gramjs",
    "teleproto"
  ],
  "bin": {
    "cursor-telegram-user-mcp": "dist/index.js",
    "telegram-user-mcp": "dist/index.js",
    "telegram-user-login": "dist/login.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/esbuild-user-server.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "login": "node dist/login.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "teleproto": "^1.228.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "zod": "^4.0.0"
  }
}
