{
  "name": "telegram-user-mcp-server",
  "version": "0.4.0",
  "private": true,
  "description": "Stdio MCP server wrapping teleproto (maintained GramJS fork) for personal Telegram account MTProto access.",
  "type": "module",
  "bin": {
    "telegram-user-mcp": "./dist/index.js",
    "telegram-user-login": "./dist/login.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/esbuild-user-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "login": "node dist/login.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "qrcode": "^1.5.4",
    "teleproto": "^1.228.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
