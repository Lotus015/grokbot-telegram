{
  "name": "telegram-bot-mcp-server",
  "version": "0.3.1",
  "private": true,
  "description": "Stdio MCP server wrapping the Telegram Bot API for the telegram-bot Cursor plugin.",
  "type": "module",
  "bin": {
    "telegram-bot-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --outfile=dist/index.js --legal-comments=eof",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
