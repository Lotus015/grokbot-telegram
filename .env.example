# Copy to .env locally if you run an MCP server by hand.
# Never commit real values. Cursor users set these in Plugins → Configure.

# Bot API mode (telegram-bot MCP) — token from @BotFather
TELEGRAM_BOT_TOKEN=

# User-account / MTProto mode (telegram-user MCP) — from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional session string from first login (full account access — treat like a password)
TELEGRAM_SESSION=

# Optional path to a session file (0600). Default: ~/.cursor-telegram-plugin/user.session
# TELEGRAM_SESSION_PATH=

# Optional footer appended to every message this plugin sends, so recipients
# know an agent sent it. Unset = default wording. Set to "off" to disable.
# TELEGRAM_DISCLAIMER=
